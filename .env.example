# Copy to .env (never committed) and fill in. Variables set in the environment take priority.
DEEPSEEK_API_KEY=
GEMINI_API_KEY=         # Google Cloud API key with Vertex AI access
GOOGLE_CLOUD_PROJECT=   # project id or number for Gemini (Vertex AI)
# RUNWAY_LLM=deepseek  # startup mode: offline, deepseek, or gemini; UI can switch per session

# Audit anchoring: notary (default, a file next to the database) or evm (any EVM JSON-RPC chain)
# RUNWAY_ANCHOR=evm
# RUNWAY_EVM_RPC_URL=http://127.0.0.1:8545
# RUNWAY_EVM_PRIVATE_KEY=   # a funded key on that chain; never commit it
